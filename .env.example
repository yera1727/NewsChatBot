# Шаблон настроек. Скопируйте в .env и заполните.
# .env не коммитится в Git (см. .gitignore) — секреты храним только там.

# Токен бота от @BotFather (обязательно)
TELEGRAM_TOKEN=

# Пароль PostgreSQL. На сервере обязательно задайте свой, длинный и случайный.
# Важно: пароль применяется только при ПЕРВОМ создании базы (пустой volume).
# POSTGRES_PASSWORD=

# Необязательные настройки (ниже значения по умолчанию):
# FETCH_INTERVAL=5m
# NOTIFY_INTERVAL=30s
# FEEDS=https://t.me/s/channel1,https://t.me/s/channel2   # начальные источники
# TZ=Asia/Almaty                                          # часовой пояс в логах

# DATABASE_URL нужен только при запуске сервисов из GoLand (не в Docker):
# DATABASE_URL=postgres://newsbot:newsbot@localhost:5433/newsbot?sslmode=disable
